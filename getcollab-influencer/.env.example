# API Configuration
# Use your machine's local WiFi IP (e.g., 192.168.x.x) for device testing
# For emulator testing, or device testing via USB debugging (adb reverse), use localhost
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
EXPO_PUBLIC_USE_LOCALHOST=true

# App Environment
EXPO_PUBLIC_APP_ENV=development

# Optional: Deep linking configuration
EXPO_PUBLIC_DEEP_LINK_SCHEME=getcollab
